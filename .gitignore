# Ambientes virtuais do Python
.venv/
venv/
env/

# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class

# Pacotes e versões geradas para distribuição
releases/

.env
.env.*
!.env.example

# Testes e cobertura
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Configurações locais de editores e IDEs
.vscode/
.idea/

# Logs e arquivos temporários
*.log
*.tmp
*.temp

# Arquivos gerados pelo Windows
Thumbs.db
Desktop.ini

# Dados do usuario: tudo que o Jarvis grava (config, chaves, lembretes, voz, cache, modelos). Ver caminhos.py
dados/

# Locais antigos desses arquivos, antes de existir dados/. Continuam ignorados para que nada com chave ou
# token va parar no Git caso a migracao automatica ainda nao os tenha movido (ex.: arquivo em uso).
/config.json
/ia_config.json
/bot_config.json
/voz.json
/navegador.json
/tempos.jsonl
/cache_planos.json
/lembretes.sqlite3*
/cache_voz/
/modelos/

# Gerado pelo Jarvis dentro da extensao (porta e token)
extensao/config.local.js
